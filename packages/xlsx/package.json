{
  "name": "@workstudio/plugin-xlsx",
  "version": "0.1.1",
  "description": "XLSX 编辑：GenOffice Sheets renderer + xlsx-gateway 写回",
  "author": "work-studio",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./ura": "./dist/ura.js"
  },
  "workstudio": {
    "id": "xlsx",
    "label": "Excel 表格",
    "icon": "table",
    "page": "dist/page/index.html",
    "apiVersion": 1
  },
  "scripts": {
    "build": "pnpm build:ura && pnpm build:page",
    "build:ura": "esbuild src/ura.ts --bundle --format=esm --platform=node --target=node22 --external:electron --outfile=dist/ura.js",
    "build:page": "vite build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.344",
    "@noble/hashes": "^1.8.0",
    "@univerjs/core": "0.25.1",
    "@univerjs/data-validation": "0.25.1",
    "@univerjs/engine-render": "0.25.1",
    "@univerjs/find-replace": "0.25.1",
    "@univerjs/preset-sheets-conditional-formatting": "0.25.1",
    "@univerjs/preset-sheets-core": "0.25.1",
    "@univerjs/preset-sheets-data-validation": "0.25.1",
    "@univerjs/preset-sheets-drawing": "0.25.1",
    "@univerjs/preset-sheets-filter": "0.25.1",
    "@univerjs/preset-sheets-find-replace": "0.25.1",
    "@univerjs/preset-sheets-note": "0.25.1",
    "@univerjs/preset-sheets-sort": "0.25.1",
    "@univerjs/preset-sheets-table": "0.25.1",
    "@univerjs/sheets-filter": "0.25.1",
    "@univerjs/themes": "0.25.1",
    "buffer": "^6.0.3",
    "fast-xml-parser": "^5.3.4",
    "fflate": "^0.8.2",
    "jszip": "^3.10.2",
    "numfmt": "^3.2.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.27.3",
    "numfmt": "^3.2.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "zod": "^4.6.7"
  }
}
