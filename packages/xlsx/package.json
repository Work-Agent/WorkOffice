{
  "name": "@workstudio/plugin-xlsx",
  "version": "0.1.0",
  "description": "XLSX 阅读：基于 GenOffice xlsx-gateway 解析，WorkStudio 自绘网格页",
  "author": "work-studio",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./ura": "./dist/ura.js"
  },
  "workstudio": {
    "id": "xlsx",
    "label": "Excel 表格",
    "icon": "table",
    "page": "dist/page/index.html"
  },
  "scripts": {
    "build": "pnpm build:ura && pnpm build:page",
    "build:ura": "esbuild src/ura.ts --bundle --format=esm --platform=node --target=node22 --external:electron --outfile=dist/ura.js",
    "build:page": "vite build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "fast-xml-parser": "^5.3.4",
    "numfmt": "^3.2.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.27.3",
    "numfmt": "^3.2.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "zod": "^4.3.6"
  }
}
