{
  "name": "@workstudio/plugin-pdf",
  "version": "0.3.0",
  "description": "PDF 只读查看器：PDF.js 真字节渲染 + WorkStudio SDK 资源读 / 页面命令",
  "author": "work-studio",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./workstudio": "./dist/engine.js"
  },
  "workstudio": {
    "id": "pdf",
    "label": "PDF 文档",
    "icon": "eye",
    "pages": {
      "content": "dist/page/index.html"
    },
    "claims": [
      {
        "extensions": [
          "pdf"
        ],
        "priority": 100
      }
    ],
    "skills": [
      "skills/pdf"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:engine": "node scripts/build.mjs --engine-only",
    "build:page": "node scripts/build.mjs --page-only",
    "gen:commands": "node scripts/gen-commands.mjs",
    "dev": "node scripts/build.mjs --assets-only && vite",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs --engine-only && node scripts/build.mjs --shared-only && node --test tests/*.test.mjs",
    "verify": "node scripts/build.mjs --engine-only && node scripts/verify.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('commands.json',{force:true});require('node:fs').rmSync('api.json',{force:true});require('node:fs').rmSync('api.d.ts',{force:true})\""
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@work-studio/sdk": "^0.2.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
