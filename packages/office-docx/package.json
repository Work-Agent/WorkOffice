{
  "name": "@workstudio/plugin-office-docx",
  "version": "0.2.0",
  "description": "Word 文档（.docx）：计划型写 · 块级字节保真 · 页面自取内容",
  "author": "work-studio",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./ura": "./dist/ura.js"
  },
  "workstudio": {
    "id": "office-docx",
    "label": "Word 文档",
    "icon": "file-text",
    "page": "dist/page-v2/index.html",
    "apiVersion": 2,
    "write": "plan",
    "content": "pulled",
    "model": "none",
    "engine": {
      "tools": "./dist/engine/tools.mjs",
      "plan": "./dist/engine/plan.mjs",
      "exec": "./dist/engine/exec.mjs",
      "read": "./dist/engine/read.mjs",
      "runtime": "./dist/engine/runtime.mjs"
    },
    "skills": [
      {
        "name": "office-docx",
        "dir": "skills/office-docx"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs && vite build",
    "build:lib": "node scripts/build.mjs --lib-only",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node --test",
    "verify": "node scripts/verify.mjs",
    "install:plugin": "node scripts/install.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:page-v2": "vite build",
    "check:slicing": "node scripts/check-slicing.mjs",
    "typecheck:v2": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vite": "^7.3.1"
  }
}
