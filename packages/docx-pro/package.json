{
  "name": "@workstudio/plugin-docx-pro",
  "version": "0.1.1",
  "description": "Word 文档（.docx）：完整编辑器 + LLM 命令面。页面交整份字节，执行点交块级切片，字节只由 exec 产生。",
  "author": "work-studio",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./ura": "./dist/ura.js"
  },
  "workstudio": {
    "id": "docx-pro",
    "label": "Word 文档",
    "icon": "file-text",
    "page": "dist/page/index.html",
    "apiVersion": 2,
    "write": "plan",
    "content": "pulled",
    "model": "none",
    "engine": {
      "tools": "./dist/engine/tools.mjs",
      "plan": "./dist/engine/plan.mjs",
      "exec": "./dist/engine/exec.mjs",
      "read": "./dist/engine/read.mjs",
      "runtime": "./dist/engine/runtime.mjs"
    },
    "skills": [
      {
        "name": "docx",
        "dir": "skills/docx"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:engine": "node scripts/build.mjs --engine-only",
    "build:page": "node scripts/build.mjs --page-only",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/engine.test.mjs tests/ura.test.mjs",
    "verify": "node scripts/verify.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:seed": "node scripts/gen-seed.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@tiptap/core": "3.31.0",
    "@tiptap/extensions": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "@tiptap/react": "3.31.0",
    "@types/node": "^24.10.1",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.27.3",
    "marked": "^17.0.6",
    "officecrypto-tool": "^0.0.19",
    "opentype.js": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "bidi-js": "^1.0.3",
    "fast-xml-parser": "^5.3.4",
    "jszip": "^3.10.1",
    "utif2": "^4.1.0"
  }
}
