{
  "commands": [
    {
      "name": "docx-pro.guide",
      "summary": "Word 命令目录：无参分组，group 取组内 schema，op 取单条",
      "args": {
        "ref": {
          "type": "string",
          "required": true
        },
        "group": {
          "enum": [
            "blocks",
            "editor",
            "actions"
          ]
        },
        "op": {
          "type": "string"
        }
      },
      "exitCodes": {
        "ok": 0,
        "failed": 1,
        "invalid": 2,
        "notFound": 3
      }
    },
    {
      "name": "docx-pro.read",
      "summary": "读 Word 文档：context / blocks / comments / notes / revisions / styles / audit",
      "args": {
        "ref": {
          "type": "string",
          "required": true
        },
        "what": {
          "enum": [
            "context",
            "blocks",
            "comments",
            "notes",
            "revisions",
            "styles",
            "audit"
          ]
        },
        "startBlockIndex": {
          "type": "number"
        },
        "endBlockIndex": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        }
      },
      "exitCodes": {
        "ok": 0,
        "failed": 1,
        "invalid": 2,
        "notFound": 3
      }
    },
    {
      "name": "docx-pro.apply",
      "summary": "在已打开的 Word 页面上执行一批命令（commands 为 JSON 字符串）；无页面直接拒绝",
      "args": {
        "ref": {
          "type": "string",
          "required": true
        },
        "commands": {
          "type": "string",
          "required": true
        },
        "baseHash": {
          "type": "string"
        },
        "docRev": {
          "type": "number"
        },
        "dryRun": {
          "type": "boolean"
        }
      },
      "exitCodes": {
        "ok": 0,
        "failed": 1,
        "invalid": 2,
        "notFound": 3
      }
    },
    {
      "name": "docx-pro.create",
      "summary": "创建一个空白 Word 文件（seed 模板，不写正文）；创建后由宿主/用户打开页面再 apply",
      "args": {
        "ref": {
          "type": "string",
          "required": true
        }
      },
      "exitCodes": {
        "ok": 0,
        "failed": 1,
        "invalid": 2,
        "notFound": 3
      }
    },
    {
      "name": "docx-pro.load",
      "summary": "页面加载当前文档字节",
      "args": {
        "ref": {
          "type": "string",
          "required": true
        },
        "base64": {
          "type": "boolean"
        }
      },
      "exitCodes": {
        "ok": 0,
        "failed": 1,
        "invalid": 2,
        "notFound": 3
      }
    },
    {
      "name": "docx-pro.save",
      "summary": "页面保存当前 ref（页面唯一落盘点）",
      "args": {
        "ref": {
          "type": "string",
          "required": true
        },
        "pageId": {
          "type": "string",
          "required": true
        },
        "baseHash": {
          "type": "string"
        },
        "type": {
          "enum": [
            "page",
            "agent"
          ]
        },
        "data": {
          "type": "string"
        }
      },
      "exitCodes": {
        "ok": 0,
        "failed": 1,
        "invalid": 2,
        "notFound": 3
      }
    },
    {
      "name": "docx-pro.attach",
      "summary": "页面登记租约",
      "args": {
        "ref": {
          "type": "string",
          "required": true
        },
        "pageId": {
          "type": "string",
          "required": true
        }
      },
      "exitCodes": {
        "ok": 0,
        "failed": 1,
        "invalid": 2,
        "notFound": 3
      }
    },
    {
      "name": "docx-pro.pending",
      "summary": "页面取回待处理请求正文",
      "args": {
        "id": {
          "type": "string",
          "required": true
        }
      },
      "exitCodes": {
        "ok": 0,
        "failed": 1,
        "invalid": 2,
        "notFound": 3
      }
    },
    {
      "name": "docx-pro.report",
      "summary": "页面上报 live 版本",
      "args": {
        "ref": {
          "type": "string",
          "required": true
        },
        "pageId": {
          "type": "string",
          "required": true
        },
        "docRev": {
          "type": "number",
          "required": true
        },
        "hash": {
          "type": "string",
          "required": true
        }
      },
      "exitCodes": {
        "ok": 0,
        "failed": 1,
        "invalid": 2,
        "notFound": 3
      }
    },
    {
      "name": "docx-pro.detach",
      "summary": "页面撤销租约",
      "args": {
        "ref": {
          "type": "string",
          "required": true
        },
        "pageId": {
          "type": "string",
          "required": true
        }
      },
      "exitCodes": {
        "ok": 0,
        "failed": 1,
        "invalid": 2,
        "notFound": 3
      }
    },
    {
      "name": "docx-pro.ack",
      "summary": "页面回执，结算待处理请求",
      "args": {
        "id": {
          "type": "string",
          "required": true
        },
        "ok": {
          "type": "boolean",
          "required": true
        },
        "payload": {
          "type": "string"
        }
      },
      "exitCodes": {
        "ok": 0,
        "failed": 1,
        "invalid": 2,
        "notFound": 3
      }
    }
  ]
}
