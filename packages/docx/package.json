{
  "name": "@workstudio/plugin-docx",
  "version": "0.1.0",
  "description": "DOCX 阅读与编辑：基于 GenOffice Docs 渲染器，字节保真保存",
  "author": "work-studio",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./ura": "./dist/ura.js"
  },
  "workstudio": {
    "id": "docx",
    "label": "Word 文档",
    "icon": "file-text",
    "page": "dist/page/index.html",
    "apiVersion": 1
  },
  "scripts": {
    "build": "pnpm build:ura && pnpm build:page",
    "build:ura": "esbuild src/ura.ts --bundle --format=esm --platform=node --target=node22 --external:electron --outfile=dist/ura.js",
    "build:page": "vite build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@tiptap/core": "3.31.0",
    "@tiptap/extensions": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "@tiptap/react": "3.31.0",
    "@types/node": "^24.10.1",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.27.3",
    "marked": "^17.0.6",
    "officecrypto-tool": "^0.0.19",
    "opentype.js": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "bidi-js": "^1.0.3",
    "fast-xml-parser": "^5.3.4",
    "jszip": "^3.10.1",
    "utif2": "^4.1.0"
  }
}
