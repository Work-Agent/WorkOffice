{
  "name": "@workstudio/plugin-docx",
  "version": "0.2.0",
  "description": "Word 文档（.docx）：WorkStudio SDK 文档页插件。页面打开才写，Agent 写经页面队列。",
  "author": "work-studio",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./workstudio": "./dist/engine.js"
  },
  "workstudio": {
    "id": "docx",
    "label": "Word 文档",
    "icon": "file-text",
    "pages": {
      "content": "dist/page/index.html"
    },
    "claims": [
      {
        "extensions": [
          "docx",
          "docm",
          "dotx"
        ],
        "priority": 100
      }
    ],
    "skills": [
      "skills/docx"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:engine": "node scripts/build.mjs --engine-only",
    "build:page": "node scripts/build.mjs --page-only",
    "gen:commands": "node scripts/gen-commands.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('commands.json',{force:true})\"",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@tiptap/core": "3.31.0",
    "@tiptap/extensions": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "@tiptap/react": "3.31.0",
    "@types/node": "^24.10.1",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.27.3",
    "marked": "^17.0.6",
    "officecrypto-tool": "^0.0.19",
    "opentype.js": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "bidi-js": "^1.0.3",
    "fast-xml-parser": "^5.3.4",
    "jszip": "^3.10.1",
    "utif2": "^4.1.0"
  }
}
