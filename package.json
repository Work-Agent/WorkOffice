{
  "name": "workstudio-office-plugins",
  "private": true,
  "version": "0.2.0",
  "description": "WorkStudio Office 插件：自有 codec + GenOffice 页面层",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-genoffice.mjs && pnpm install",
    "build": "pnpm --filter \"./packages/*\" run build",
    "build:docx": "pnpm --filter @workstudio/plugin-docx build",
    "build:xlsx": "pnpm --filter @workstudio/plugin-xlsx build",
    "build:pptx": "pnpm --filter @workstudio/plugin-pptx build",
    "build:pdf": "pnpm --filter @workstudio/plugin-pdf build",
    "typecheck": "pnpm --filter \"./packages/*\" run typecheck",
    "test": "pnpm --filter \"./packages/*\" run test",
    "test:docx": "pnpm --filter @workstudio/plugin-docx test",
    "test:xlsx": "pnpm --filter @workstudio/plugin-xlsx test",
    "test:pptx": "pnpm --filter @workstudio/plugin-pptx test",
    "test:pdf": "pnpm --filter @workstudio/plugin-pdf test",
    "verify": "pnpm --filter \"./packages/*\" run verify",
    "verify:docx": "pnpm --filter @workstudio/plugin-docx verify",
    "verify:xlsx": "pnpm --filter @workstudio/plugin-xlsx verify",
    "verify:pptx": "pnpm --filter @workstudio/plugin-pptx verify",
    "verify:pdf": "pnpm --filter @workstudio/plugin-pdf verify",
    "clean": "pnpm --filter \"./packages/*\" run clean",
    "pack:plugins": "node scripts/pack.mjs",
    "pack:docx": "node scripts/pack.mjs --only docx",
    "pack:xlsx": "node scripts/pack.mjs --only xlsx",
    "pack:pptx": "node scripts/pack.mjs --only pptx",
    "pack:pdf": "node scripts/pack.mjs --only pdf",
    "registry:entry": "node scripts/write-registry-entry.mjs",
    "install:plugins": "node scripts/install.mjs",
    "install:builtin": "node scripts/install.mjs --target ../WorkStudio/src/plugins"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "fflate": "^0.8.2"
  },
  "packageManager": "pnpm@10.18.0"
}
